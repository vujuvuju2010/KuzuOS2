/* GNU stab debug symbol types */
__define_stab(N_UNDF, 0x0, "Undefined symbol")
__define_stab(N_ABS, 0x2, "Absolute symbol")
__define_stab(N_TEXT, 0x4, "Text symbol")
__define_stab(N_DATA, 0x6, "Data symbol")
__define_stab(N_BSS, 0x8, "BSS symbol")
__define_stab(N_INDR, 0xa, "Indirect symbol")
__define_stab(N_COMM, 0x12, "Common symbol")
__define_stab(N_SETA, 0x14, "Absolute set element")
__define_stab(N_SETT, 0x16, "Text set element")
__define_stab(N_SETD, 0x18, "Data set element")
__define_stab(N_SETB, 0x1a, "BSS set element")
__define_stab(N_SETV, 0x1c, "Variant set element")
__define_stab(N_WARNING, 0x1e, "Warning symbol")
__define_stab(N_FN, 0x1e, "Function name")
__define_stab(N_FUN, 0x24, "Function name")
__define_stab(N_FN_SEQ, 0x3c, "Function name sequence")
__define_stab(N_VERSYM, 0x20, "Version symbol")
__define_stab(N_WEAKU, 0x30, "Weak undefined symbol")
__define_stab(N_WEAKA, 0x32, "Weak absolute symbol")
__define_stab(N_WEAKT, 0x34, "Weak text symbol")
__define_stab(N_WEAKD, 0x36, "Weak data symbol")
__define_stab(N_WEAKB, 0x38, "Weak BSS symbol")
__define_stab(N_GSYM, 0x20, "Global symbol")
__define_stab(N_LSYM, 0x80, "Local symbol")
__define_stab(N_PSYM, 0xa0, "Parameter symbol")
__define_stab(N_STSYM, 0x26, "Static symbol")
__define_stab(N_LCSYM, 0x28, "Local common symbol")
__define_stab(N_MAIN, 0x2a, "Main program")
__define_stab(N_PC, 0x30, "Program counter")
__define_stab(N_NSYMS, 0x32, "Number of symbols")
__define_stab(N_NOMAP, 0x34, "No map")
__define_stab(N_OBJ, 0x38, "Object file")
__define_stab(N_OPT, 0x3c, "Optional symbol")
__define_stab(N_SO, 0x64, "Source file")
__define_stab(N_SOL, 0x84, "Source line")
__define_stab(N_SLINE, 0x44, "Source line number")
__define_stab(N_BINCL, 0x82, "Begin include")
__define_stab(N_EINCL, 0xa2, "End include")
__define_stab(N_EXCL, 0xc2, "Exclude")
__define_stab(N_ENTRY, 0xa4, "Alternate entry")
__define_stab(N_LBRAC, 0xc0, "Left bracket")
__define_stab(N_RBRAC, 0xe0, "Right bracket")
